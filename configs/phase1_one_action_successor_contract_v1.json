      "occupancy",
      "mass",
      "action_aligned_vertical_velocity",
      "contact_count",
      "normal_impulse"
    ],
    "optional_separate_ablation_inputs": {
      "stress": ["mean_stress", "von_mises_stress"],
      "elastic": ["elastic_jacobian", "elastic_isochoric_shear"]
    },
    "excluded_inputs": ["plastic_jacobian", "soil_specific_derived_features", "higher_order_constitutive_descriptors"],
    "target_arrays_are_never_model_inputs": true
  },
  "model_contract": {
