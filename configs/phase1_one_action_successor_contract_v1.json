    "parameter_count_minimum": 100000,
    "parameter_count_maximum": 1000000,
    "training_seeds": [20261101, 20261102, 20261103],
    "selection_pool": ["D0", "R0", "R1"],
    "optional_ablation_pool": ["R2S", "R2E"],
    "variants": {
      "D0": ["core_inputs"],
      "R0": ["core_inputs", "newton_surface_inputs"],
      "R1": ["core_inputs", "newton_surface_inputs", "robotics_facing_newton_inputs"],
      "R2S": ["R1", "stress"],
      "R2E": ["R1", "elastic"]
    },
    "same_capacity_across_learned_variants": true,
    "train_only_normalization": true,
    "validation_only_selection_and_uncertainty_calibration": true
  },
  "evaluation_contract": {
    "primary_regions": ["footprint", "twice_radius"],
    "primary_metric": "whole_episode_rmse_m",
    "baseline_models": ["no_deformation", "raw_newton", "D0"],
    "median_rmse_reduction_vs_raw_newton_minimum": 0.3,
    "episode_improvement_fraction_minimum": 0.9,
    "maximum_regression_relative": 0.1,
    "maximum_regression_absolute_m": 0.001,
