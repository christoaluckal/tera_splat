{
  "schema_version": 1,
  "training_id": "phase1_bed_state_training_v1",
  "status": "prospective_implementation_before_dataset_admission",
  "authority": "docs/newton/phase1.md",
  "phase1_contract": "configs/phase1_bed_state_v1.json",
  "bulk_config": "configs/phase1_dataset_bulk_v1.json",
  "bulk_summary": "outputs/validity_experiment/newton/phase1_bed_state_v1/dataset_bulk_v1/bulk_summary.json",
  "required_bulk_status": "passed",
  "required_training_dataset_ready": true,
  "models": ["B3", "H0", "H1", "H2"],
  "model": {
    "family": "shared_three_level_parameter_conditioned_2d_unet",
    "base_channels": 16,
    "channel_multipliers": [1, 2, 4],
    "residual_blocks_per_scale": 2,
    "normalization": "group_norm",
    "activation": "silu",
    "conditioning": "feature_wise_affine_at_every_encoder_bottleneck_and_decoder_scale",
    "phase_output": "shared_decoder_with_separate_loaded_and_post_unload_heads",
    "mean_head_initialization": "zero",
    "variance_head_initialization": "zero_weight_fixed_bias",
    "initial_variance_m2": 0.000025,
    "variance_floor_m2": 1e-8,
    "parameter_count_minimum": 100000,
    "parameter_count_maximum": 1000000,
    "fixed_capacity_across_variants": true
  },
  "normalization": {
    "fit_split": "train",
    "spatial_method": "per_channel_finite_valid_cells_mean_std_with_binary_support_masks_passthrough",
    "global_method": "per_feature_episode_mean_std",
    "minimum_std": 1e-8,
    "correction_scale_quantile": 0.995,
    "correction_scale_minimum_m": 0.001,
    "boundary_taper_width_cells": 8,
    "validation_may_not_refit": true,
    "test_may_not_refit": true
  },
  "optimization": {
    "training_seeds": [20261022, 20261023, 20261024],
    "batch_size": 4,
    "maximum_epochs": 300,
    "early_stopping_patience": 35,
    "learning_rate": 0.0003,
    "weight_decay": 0.00001,
    "gradient_clip_norm": 1.0,
    "mixed_precision": true,
    "deterministic_algorithms": true,
    "selection_metric": "validation_mean_loaded_and_post_twice_radius_rmse_m"
  },
  "uncertainty_calibration": {
    "fit_split": "validation",
    "method": "absolute_standardized_residual_conformal_multiplier",
    "nominal_coverage": 0.9,
    "region": "twice_radius",
    "quantile_method": "higher",
    "separate_loaded_and_post_unload": true
  },
  "loss_weights": {
    "robust_footprint": 1.0,
    "robust_twice_radius": 1.0,
    "robust_valid_bed": 0.25,
    "heteroscedastic_nll": 0.25,
    "peak_depression": 0.1,
    "mean_footprint_depression": 0.1,
    "displaced_volume": 0.1,
    "deformation_footprint": 0.05,
    "deformation_centroid": 0.05,
    "recovery": 0.1,
    "residual_magnitude": 0.0001,
    "spatial_smoothness": 0.001,
    "no_action_identity": 0.1,
    "boundary_taper": 0.1,
    "particle_surface_reproduction": 0.0,
    "particle_state_preservation": 0.0
  },
  "hard_constraints": {
    "particle_surface_reproduction": "deterministic grid-to-particle lift must reproduce the predicted surface within the frozen tolerance",
    "particle_state_preservation": "only particle position z may change; count and all other archived fields must remain bitwise identical"
  },
  "particle_lift": {
    "method": "columnwise_linear_depth_taper",
    "cutoff_depth_m": 0.1,
    "surface_reproduction_tolerance_m": 1e-6,
    "require_every_valid_cell_observed": true,
    "preserve_particles_outside_valid_support": true
  },
  "controls": {
    "h1_shuffled_parameters": true,
    "h1_constant_parameters": true,
    "same_capacity_b3": true,
    "same_splits_and_normalization": true,
    "model_selection_before_test_unlock": true
  },
  "execution": {
    "python": "/eng/home/christoa/miniconda3/envs/test/bin/python",
    "device": "cuda:0",
    "output_root": "outputs/validity_experiment/newton/phase1_bed_state_v1/training_v1",
    "freeze_plan_before_first_fit": true
  }
}
